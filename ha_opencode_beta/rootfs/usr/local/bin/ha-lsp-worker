#!/usr/bin/env python3
"""Credential-bearing LSP worker, invoked only by the root Unix-socket service."""
import ctypes
import os
import resource

if os.geteuid() != 0 or os.environ.get("IPCREMOTEEUID") != "0" or not os.environ.get("SUPERVISOR_TOKEN"):
    raise SystemExit("HA LSP worker requires the supervised credential environment")
resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
if ctypes.CDLL(None).prctl(4, 0, 0, 0, 0) != 0:
    raise SystemExit("HA LSP worker could not disable process inspection")
environment = {
    "PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": "/run/opencode-v2",
    "LANG": "C.UTF-8", "SUPERVISOR_TOKEN": os.environ["SUPERVISOR_TOKEN"],
    "LD_PRELOAD": "/usr/local/lib/opencode-v2-non-dumpable.so",
}
os.execve("/usr/local/bin/node", ["node", "/opt/ha-lsp-server/server.js", "--stdio"], environment)
